// Taskflow data model.
// The whole model is defined in Stage 1 so later stages add features, not migrations churn.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  sessions      Session[]
  memberships   Membership[]
  invitesSent   Invite[]     @relation("InviteSender")
  createdTasks  Task[]       @relation("TaskCreator")
  assignedTasks Task[]       @relation("TaskAssignee")
  comments      Comment[]
  activities    Activity[]
}

// Database-backed sessions: the cookie holds a random token, the DB stores only its SHA-256 hash.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Teams & permissions ----------

enum Role {
  OWNER // full control, can delete team and transfer ownership
  ADMIN // manage members and projects
  MEMBER // create and edit tasks and comments
  VIEWER // read-only
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  invites     Invite[]
  projects    Project[]
  activities  Activity[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Invite {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

// ---------- Work ----------

model Project {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  key         String // short prefix for task ids, e.g. "WEB" -> WEB-12
  description String?
  taskCounter Int       @default(0) // incremented atomically to number tasks per project
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([teamId, key])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  number      Int // per-project sequence, shown as KEY-number
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(NONE)
  // Fractional ordering inside a column: inserting between 1.0 and 2.0 uses 1.5,
  // so a drag-and-drop move updates one row instead of renumbering the column.
  position    Float
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assigneeId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ---------- Audit trail ----------

// Append-only log. Written in the same transaction as the change it describes.
// entityType/entityId are deliberately loose (no FK) so history survives deletions.
model Activity {
  id         String   @id @default(cuid())
  teamId     String
  actorId    String
  entityType String // "task" | "project" | "comment" | "membership" | ...
  entityId   String
  action     String // "task.created" | "task.status_changed" | ...
  metadata   Json? // e.g. { "from": "TODO", "to": "DONE" }
  createdAt  DateTime @default(now())

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([entityType, entityId, createdAt])
}
